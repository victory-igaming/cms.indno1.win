{
  "kind": "collectionType",
  "collectionName": "playgames",
  "info": {
    "singularName": "playgame",
    "pluralName": "playgames",
    "displayName": "playgame"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "gamename": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "meta_title": {
      "type": "string"
    },
    "meta_tag": {
      "type": "text"
    },
    "meta_discrp": {
      "type": "text"
    },
    "gameicon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "gamebanner": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "gameimage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "seourl": {
      "type": "uid",
      "targetField": "gamename"
    },
    "gamecategoties": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::gamepage.gamepage",
      "mappedBy": "playgames"
    },
    "gameurl": {
      "type": "string"
    },
    "bodysponce": {
      "type": "dynamiczone",
      "components": [
        "support.image-left",
        "support.image-right",
        "support.artical",
        "block.tipwarn",
        "block.tipsuccess",
        "block.tipdanger",
        "support.faq",
        "support.suportcard",
        "block.description",
        "support.image-block"
      ]
    },
    "sponsors": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::sponsor.sponsor",
      "mappedBy": "playgames"
    },
    "youtubeurl": {
      "type": "string"
    },
    "gameplayurl": {
      "type": "text"
    },
    "isIframeuse": {
      "type": "boolean",
      "default": true
    },
    "startprice": {
      "type": "decimal"
    },
    "pricerate": {
      "type": "integer"
    },
    "gamebody": {
      "type": "component",
      "component": "support.howtoplay",
      "repeatable": true
    }
  }
}
