{
  "kind": "singleType",
  "collectionName": "gameplays",
  "info": {
    "singularName": "gameplay",
    "pluralName": "gameplays",
    "displayName": "gameplay"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "pagename": {
      "type": "string"
    },
    "seourl": {
      "type": "uid",
