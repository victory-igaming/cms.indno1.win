    },
    "heroimage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "gamebody": {
      "type": "dynamiczone",
      "components": [
        "support.image-left",
        "support.image-right",
        "support.artical",
        "block.tipwarn",
        "block.tipsuccess",
        "block.tipdanger",
        "block.description"
      ]
    },
    "gamefaq": {
      "type": "component",
      "component": "support.faq",
      "repeatable": true
    }
  }
}
